{
  "$schema": "http://json.schemastore.org/template",
  "author": "AdamTalleh",
  "classifications": ["Web", "API", "Modular Monolith"],
  "identity": "AdamTalleh.ModularSkeleton",
  "name": ".NET Modular Monolith Skeleton",
  "description": ".NET 10 modular-monolith backend with tests, CI/CD and container publishing.",
  "shortName": "modular-skeleton",
  "sourceName": "Skeleton",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".claude/**",
            ".vs/**",
            ".idea/**",
            ".template.config/**",
            "**/bin/**",
            "**/obj/**",
            "TestResults/**",
            "**/*.user",
            "README.md"
          ]
        }
      ]
    }
  ]
}
